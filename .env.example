# IMA OpenAPI 凭证
# 获取地址: https://ima.qq.com/agent-interface
IMA_API_KEY=your_api_key_here
IMA_CLIENT_ID=your_client_id_here

# O365 (Microsoft Graph) 邮件发送
# Azure AD 应用注册 → 证书和密码 → 客户端密码
O365_CLIENT_ID=your_azure_ad_app_id
O365_CLIENT_SECRET=your_client_secret
O365_TENANT_ID=your_tenant_id

# 发件人（O365 邮箱地址）
EMAIL_FROM=your-email@your-domain.com

# 收件人
EMAIL_TO=target@example.com
LIST_EMAIL_TO=target@example.com
STATUS_EMAIL_TO=target@example.com

# 可选：忽略关键词（逗号分隔，大小写不敏感）
# KEYWORD_IGNORE=关键词1,关键词2

# DeepSeek LLM（研报分类）
DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# SharePoint（研报上传，复用上方 O365 应用凭证）
SHAREPOINT_TENANT=your-tenant
SHAREPOINT_SITE_PATH=/sites/ResearchReports
SHAREPOINT_DRIVE_NAME=Research Library
# SHAREPOINT_ENABLED=true
