# IMA OpenAPI 凭证
# 获取地址: https://ima.qq.com/agent-interface
IMA_API_KEY=your_api_key_here
IMA_CLIENT_ID=your_client_id_here

# Resend 邮件 API
# 获取地址: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# 发件人（需在 Resend 中验证的域名）
EMAIL_FROM=reports@your-domain.com

# 收件人
EMAIL_TO=target@example.com
